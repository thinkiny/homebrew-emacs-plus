@@ -519,6 +544,11 @@ - (void) userContentController:(WKUserContentController *)userContentController
   NSString *javascriptString = [NSString stringWithUTF8String:script];
   [xwWebView evaluateJavaScript:javascriptString
               completionHandler:^(id result, NSError *error) {
+      /* nsxwidget_kill clears xwWebView.xw before the struct is freed
+         by GC; if that has happened, xw is dangling, so drop the
+         result instead of enqueuing a callback for it.  */
+      if (xwWebView.xw != xw)
+        return;
       if (error)
         {
           NSLog (@"evaluateJavaScript error : %@", error.localizedDescription);
@@ -568,8 +598,17 @@ - (void) drawRect:(NSRect)dirty_rect
 void
 nsxwidget_kill (struct xwidget *xw)
 {
-  if (xw)
+  if (xw && xw->xwWidget)
     {
+      /* Drop the view's raw pointer to the xwidget *before* any
+         further work: about:blank navigation and view teardown can
+         fire WebKit delegate callbacks asynchronously, and the struct
+         is freed by GC once kill_xwidget has unrooted it.  With the
+         pointer cleared, every delegate takes its null-guarded early
+         return instead of enqueuing an event that prints a freed
+         xwidget (print_object fault).  */
+      ((XwWebView *) xw->xwWidget).xw = NULL;
+
       WKUserContentController *scriptor =
         ((XwWebView *) xw->xwWidget).configuration.userContentController;
       [scriptor removeAllUserScripts];
diff --git a/src/xwidget.c b/src/xwidget.c
index 62769c1c368..5dbe31c6010 100644
--- a/src/xwidget.c
+++ b/src/xwidget.c
@@ -4288,6 +4288,12 @@ kill_xwidget (struct xwidget *xw)
 
   catch_child_signal ();
 #elif defined NS_IMPL_COCOA
+  /* Nil the buffer before tearing down the view so print_object renders
+     "#<killed xwidget>" (print.c) instead of dereferencing a struct freed
+     by GC, and so `xwidget-live-p' reports nil for events already queued
+     when the widget died.  Mirrors the GTK branch above.  */
+  xw->buffer = Qnil;
+  Fremhash (make_fixnum (xw->xwidget_id), id_to_xwidget_map);
   nsxwidget_kill (xw);
 #endif
 }
